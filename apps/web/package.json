{
  "name": "@personal-plan/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "core:build": "pnpm --filter @personal-plan/core build",
    "sync:build": "pnpm --filter @personal-plan/sync build",
    "deps:build": "pnpm core:build && pnpm sync:build",
    "predev": "pnpm deps:build",
    "dev": "vite",
    "prebuild": "pnpm deps:build",
    "build": "pnpm build:app",
    "build:app": "pnpm icons:generate && tsc --noEmit && vite build",
    "pree2e": "pnpm deps:build",
    "e2e": "pnpm build:app && playwright test",
    "icons:generate": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "preview:test": "vite preview --host 127.0.0.1 --port 4173",
    "pretest": "pnpm deps:build",
    "test": "vitest run",
    "pretypecheck": "pnpm deps:build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test e2e playwright.config.ts vite.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@personal-plan/core": "workspace:*",
    "@personal-plan/sync": "workspace:*",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "vitest": "^4.1.10"
  }
}
