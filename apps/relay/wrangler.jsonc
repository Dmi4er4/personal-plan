{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-plan-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "durable_objects": {
    "bindings": [{ "name": "VAULTS", "class_name": "VaultObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VaultObject"] }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*"]
  }
}
