{
  "name": "@personal-plan/relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deps:build": "pnpm --workspace-root build:deps",
    "predev": "pnpm deps:build",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "pretest": "pnpm deps:build",
    "test": "vitest run && node --test test/node-relay.test.mjs",
    "pretypecheck": "pnpm deps:build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test node-server.mjs",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@personal-plan/sync": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260804.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.31.0"
  }
}
